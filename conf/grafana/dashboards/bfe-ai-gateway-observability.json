        {
          "dataset": "bfe_observability",
          "datasource": { "type": "mysql", "uid": "doris" },
          "editorMode": "builder",
          "format": "table",
          "rawSql": "SELECT name, SUM(cnt) AS count FROM (SELECT CASE WHEN rn <= 10 THEN ai_provider ELSE '其他' END AS name, cnt FROM (SELECT ai_provider, cnt, ROW_NUMBER() OVER (ORDER BY cnt DESC) AS rn FROM (SELECT ai_provider, SUM(request_count) AS cnt FROM bfe_ai_metrics_1m WHERE ts_min >= $__timeFrom() AND ts_min < $__timeTo() AND ai_provider != '' GROUP BY ai_provider) a) b) c GROUP BY name ORDER BY CASE WHEN name = '其他' THEN 1 ELSE 0 END, count DESC",
          "refId": "A",
          "table": "bfe_ai_metrics_1m"
        }
      ],
      "options": {
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" },
