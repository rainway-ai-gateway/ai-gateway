          "format": "table",
          "rawSql": "SELECT ai_requested_model, ai_target_model, SUM(request_count) AS total_requests, SUM(total_tokens) AS total_tokens, SUM(error_count) AS error_count, IFNULL(SUM(error_count) / NULLIF(SUM(request_count), 0), 0) AS error_rate FROM bfe_ai_metrics_1m WHERE ts_min >= $__timeFrom() AND ts_min < $__timeTo() GROUP BY ai_requested_model, ai_target_model ORDER BY total_requests DESC LIMIT 10",
